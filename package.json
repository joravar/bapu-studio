{
  "name": "bapu-studio",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "main": "electron-main.cjs",
  "description": "The honest, open-source, local-first developer cockpit for APIs, Databases, and Secrets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-all-tests.mjs",
    "test:postgres": "node scripts/test-postgres-integration.mjs",
    "test:mysql": "node scripts/test-mysql-integration.mjs",
    "test:mongodb": "node scripts/test-mongodb-integration.mjs",
    "desktop": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "mongodb-memory-server": "^11.2.0",
    "mysql-memory-server": "^1.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "dev.bapustudio.app",
    "productName": "Bapu Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "Bapu-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Bapu-Studio-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "Joravar <support@bapustudio.dev>"
    },
    "publish": {
      "provider": "github",
      "owner": "joravar",
      "repo": "bapu-studio",
      "releaseType": "release"
    },
    "artifactName": "Bapu-Studio-${version}-${os}-${arch}.${ext}"
  },
  "author": "Joravar <support@bapustudio.dev>"
}
