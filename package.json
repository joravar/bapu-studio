{
  "name": "bapu-studio",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron-main.cjs",
  "description": "The honest, open-source, local-first developer cockpit for APIs, Databases, and Secrets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-all-tests.mjs",
    "desktop": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "dev.bapustudio.app",
    "productName": "Bapu Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "Bapu-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Bapu-Studio-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "Joravar <support@bapustudio.dev>"
    },
    "publish": {
      "provider": "github",
      "owner": "joravar",
      "repo": "bapu-studio",
      "releaseType": "release"
    },
    "artifactName": "Bapu-Studio-${version}-${os}-${arch}.${ext}"
  },
  "author": "Joravar <support@bapustudio.dev>"
}
